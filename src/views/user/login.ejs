<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>登录 - 校园二手交易平台</title>
  <style>
    @font-face {
      font-family: 'KaiTi';
      src: local('KaiTi'), local('STKaiti'), local('SimKai'), local('楷体');
    }
    :root {
      --primary: #1B5E20;
      --primary-dark: #144518;
      --secondary: #F5F5DC;
      --accent: #8B4513;
      --text: #3E2723;
      --text-muted: #5D4037;
      --border: #8D6E63;
      --bg: #FFF8E1;
      --bg-paper: #FFFEF5;
    }
    *, *::before, *::after {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }
    body {
      font-family: "KaiTi", "楷体", STKaiti, SimKai, serif;
      background-color: var(--bg);
      background-image:
        linear-gradient(90deg, transparent 95%, rgba(139, 69, 19, 0.03) 95%),
        linear-gradient(transparent 95%, rgba(139, 69, 19, 0.03) 95%);
      background-size: 20px 20px;
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 20px;
      color: var(--text);
    }
    .auth-container {
      width: 100%;
      max-width: 380px;
    }
    .auth-card {
      background: var(--bg-paper);
      border: 3px double var(--border);
      border-radius: 8px;
      padding: 40px 36px;
      box-shadow: 4px 4px 0 rgba(62, 39, 35, 0.15);
      position: relative;
    }
    .auth-card::before {
      content: '';
      position: absolute;
      top: 8px;
      left: 8px;
      right: 8px;
      bottom: 8px;
      border: 1px dashed var(--border);
      border-radius: 4px;
      pointer-events: none;
      opacity: 0.5;
    }
    .auth-header {
      text-align: center;
      margin-bottom: 32px;
      position: relative;
    }
    .auth-icon {
      width: 56px;
      height: 56px;
      background: var(--primary);
      border-radius: 4px;
      display: flex;
      align-items: center;
      justify-content: center;
      margin: 0 auto 16px;
      border: 2px solid var(--primary-dark);
    }
    .auth-icon svg {
      width: 28px;
      height: 28px;
      color: var(--secondary);
    }
    .auth-title {
      font-size: 28px;
      font-weight: bold;
      color: var(--primary);
      margin-bottom: 8px;
      letter-spacing: 4px;
    }
    .auth-subtitle {
      font-size: 14px;
      color: var(--text-muted);
    }
    .form-group {
      margin-bottom: 20px;
      position: relative;
      z-index: 1;
    }
    .form-label {
      display: block;
      font-size: 14px;
      font-weight: bold;
      color: var(--text);
      margin-bottom: 8px;
    }
    .form-input {
      width: 100%;
      height: 44px;
      padding: 0 14px;
      font-family: inherit;
      font-size: 15px;
      color: var(--text);
      background: #FFF;
      border: 2px solid var(--border);
      border-radius: 4px;
      outline: none;
      transition: all 0.2s;
    }
    .form-input::placeholder {
      color: #A1887F;
    }
    .form-input:focus {
      border-color: var(--primary);
      box-shadow: 0 0 0 3px rgba(27, 94, 32, 0.1);
    }
    .checkbox-group {
      display: flex;
      align-items: center;
      gap: 8px;
      margin-bottom: 20px;
      position: relative;
      z-index: 1;
    }
    .checkbox-group input {
      width: 18px;
      height: 18px;
      accent-color: var(--primary);
    }
    .checkbox-group label {
      font-size: 14px;
      color: var(--text-muted);
      cursor: pointer;
    }
    .btn-primary {
      width: 100%;
      height: 46px;
      font-family: inherit;
      font-size: 16px;
      font-weight: bold;
      color: var(--secondary);
      background: linear-gradient(180deg, var(--primary) 0%, var(--primary-dark) 100%);
      border: 2px solid var(--primary-dark);
      border-radius: 4px;
      cursor: pointer;
      transition: all 0.2s;
      letter-spacing: 2px;
      position: relative;
      z-index: 1;
    }
    .btn-primary:hover {
      background: linear-gradient(180deg, #1E6E22 0%, var(--primary) 100%);
      transform: translateY(-1px);
      box-shadow: 0 4px 8px rgba(27, 94, 32, 0.3);
    }
    .btn-primary:active {
      transform: translateY(0);
    }
    .auth-footer {
      text-align: center;
      margin-top: 24px;
      padding-top: 20px;
      border-top: 1px dashed var(--border);
      position: relative;
      z-index: 1;
    }
    .auth-footer p {
      font-size: 14px;
      color: var(--text-muted);
    }
    .auth-footer a {
      color: var(--accent);
      text-decoration: none;
      font-weight: bold;
      transition: color 0.2s;
    }
    .auth-footer a:hover {
      color: var(--primary);
      text-decoration: underline;
    }
    .alert-error {
      padding: 12px 16px;
      margin-bottom: 20px;
      background: #FFEBEE;
      border: 1px solid #EF9A9A;
      border-radius: 4px;
      color: #C62828;
      font-size: 14px;
      display: flex;
      align-items: center;
      gap: 8px;
      position: relative;
      z-index: 1;
    }
    .alert-error svg {
      width: 18px;
      height: 18px;
      flex-shrink: 0;
    }
    @media (max-width: 420px) {
      .auth-card {
        padding: 32px 24px;
      }
      .auth-title {
        font-size: 24px;
      }
    }
  </style>
</head>
<body>
  <div class="auth-container">
    <div class="auth-card">
      <div class="auth-header">
        <div class="auth-icon">
          <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"></path>
          </svg>
        </div>
        <h1 class="auth-title">登录</h1>
        <p class="auth-subtitle">校园二手交易平台</p>
      </div>

      <% if (error) { %>
      <div class="alert-error">
        <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
        </svg>
        <span><%= error %></span>
      </div>
      <% } %>

      <form id="loginForm" method="POST" action="/login">
        <div class="form-group">
          <label class="form-label" for="phone">手机号</label>
          <input type="tel" class="form-input" id="phone" name="phone"
                 placeholder="请输入手机号" value="<%= phone || '' %>" required>
        </div>

        <div class="form-group">
          <label class="form-label" for="password">密码</label>
          <input type="password" class="form-input" id="password" name="password"
                 placeholder="请输入密码" required>
        </div>

        <div class="checkbox-group">
          <input type="checkbox" id="remember" name="remember">
          <label for="remember">记住账号</label>
        </div>

        <button type="submit" class="btn-primary">登 录</button>
      </form>

      <div class="auth-footer">
        <p>还没有账号？<a href="/register">立即注册</a></p>
      </div>
    </div>
  </div>

  <script>
    document.getElementById('loginForm').addEventListener('submit', function(e) {
      const phone = document.getElementById('phone').value.trim();
      const password = document.getElementById('password').value;
      if (!phone || !password) {
        alert('请填写完整信息');
        e.preventDefault();
      }
    });
    const savedPhone = localStorage.getItem('savedPhone');
    if (savedPhone) {
      document.getElementById('phone').value = savedPhone;
      document.getElementById('remember').checked = true;
    }
    document.getElementById('remember').addEventListener('change', function() {
      if (this.checked) {
        localStorage.setItem('savedPhone', document.getElementById('phone').value);
      } else {
        localStorage.removeItem('savedPhone');
      }
    });
  </script>
</body>
</html>