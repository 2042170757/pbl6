<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>商品列表 - 校园二手交易平台</title>
  <style>
    /* 本地字体，无外部CDN依赖 */

    :root {
      --bg-deep: #0a0a0f;
      --bg-card: rgba(15, 15, 25, 0.9);
      --neon-cyan: #00f0ff;
      --neon-pink: #ff00aa;
      --neon-purple: #8b5cf6;
      --neon-blue: #3b82f6;
      --text-primary: #e0e0e0;
      --text-muted: #8892a0;
      --glow-cyan: 0 0 20px rgba(0, 240, 255, 0.4);
      --glow-pink: 0 0 20px rgba(255, 0, 170, 0.4);
    }

    *, *::before, *::after {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      font-family: 'Segoe UI', 'Microsoft YaHei', 'PingFang SC', sans-serif;
      background: var(--bg-deep);
      min-height: 100vh;
      color: var(--text-primary);
      position: relative;
    }

    body::before {
      content: '';
      position: fixed;
      top: 0;
      left: 0;
      right: 0;
      bottom: 0;
      background:
        linear-gradient(90deg, rgba(0, 240, 255, 0.02) 1px, transparent 1px),
        linear-gradient(rgba(0, 240, 255, 0.02) 1px, transparent 1px);
      background-size: 50px 50px;
      pointer-events: none;
      z-index: 0;
    }

    .navbar {
      background: rgba(8, 8, 15, 0.95);
      backdrop-filter: blur(20px);
      padding: 0 24px;
      height: 64px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      border-bottom: 1px solid rgba(0, 240, 255, 0.15);
      position: relative;
      z-index: 10;
    }

    .navbar::after {
      content: '';
      position: absolute;
      bottom: 0;
      left: 0;
      right: 0;
      height: 1px;
      background: linear-gradient(90deg, transparent, var(--neon-cyan), var(--neon-pink), transparent);
    }

    .navbar-brand {
      display: flex;
      align-items: center;
      gap: 14px;
      color: var(--text-primary);
      text-decoration: none;
    }

    .brand-icon {
      width: 38px;
      height: 38px;
      background: linear-gradient(135deg, var(--neon-cyan), var(--neon-purple));
      border-radius: 8px;
      display: flex;
      align-items: center;
      justify-content: center;
      box-shadow: var(--glow-cyan);
    }

    .brand-icon svg {
      width: 20px;
      height: 20px;
      color: #000;
    }

    .brand-text {
      font-family: 'Segoe UI', 'Microsoft YaHei', sans-serif;
      font-size: 18px;
      font-weight: 700;
      letter-spacing: 2px;
      background: linear-gradient(90deg, var(--neon-cyan), #fff);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
    }

    .navbar-user {
      display: flex;
      align-items: center;
      gap: 20px;
    }

    .user-name {
      color: var(--text-muted);
      font-size: 15px;
      font-weight: 500;
    }

    .user-name span {
      color: var(--neon-cyan);
    }

    .btn-logout {
      padding: 8px 20px;
      font-family: 'Segoe UI', 'Microsoft YaHei', sans-serif;
      font-size: 14px;
      font-weight: 600;
      color: var(--neon-pink);
      background: transparent;
      border: 1px solid var(--neon-pink);
      border-radius: 6px;
      text-decoration: none;
      transition: all 0.3s;
      text-transform: uppercase;
      letter-spacing: 1px;
    }

    .nav-link {
      color: var(--text-muted);
      text-decoration: none;
      font-size: 14px;
      font-weight: 600;
      transition: color 0.3s;
    }

    .nav-link:hover {
      color: var(--neon-cyan);
    }

    .btn-logout:hover {
      background: rgba(255, 0, 170, 0.1);
      box-shadow: var(--glow-pink);
    }

    .container {
      max-width: 1100px;
      margin: 0 auto;
      padding: 40px 24px;
      position: relative;
      z-index: 1;
    }

    .page-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 32px;
      padding-bottom: 24px;
      border-bottom: 1px solid rgba(0, 240, 255, 0.1);
    }

    .page-title {
      font-family: 'Segoe UI', 'Microsoft YaHei', sans-serif;
      font-size: 28px;
      font-weight: 700;
      background: linear-gradient(90deg, var(--neon-cyan), #fff);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
      letter-spacing: 2px;
    }

    .btn-publish {
      padding: 12px 28px;
      font-family: 'Segoe UI', 'Microsoft YaHei', sans-serif;
      font-size: 14px;
      font-weight: 600;
      color: #000;
      background: linear-gradient(135deg, var(--neon-cyan), var(--neon-blue));
      border: none;
      border-radius: 8px;
      text-decoration: none;
      transition: all 0.3s;
      text-transform: uppercase;
      letter-spacing: 2px;
    }

    .btn-publish:hover {
      box-shadow: var(--glow-cyan);
      transform: translateY(-2px);
    }

    .toolbar {
      display: grid;
      grid-template-columns: 1fr 180px auto;
      gap: 14px;
      margin-bottom: 28px;
      padding: 18px;
      background: var(--bg-card);
      border: 1px solid rgba(0, 240, 255, 0.15);
      border-radius: 14px;
      backdrop-filter: blur(20px);
    }

    .toolbar input,
    .toolbar select {
      width: 100%;
      height: 42px;
      padding: 0 14px;
      font-family: 'Segoe UI', 'Microsoft YaHei', 'PingFang SC', sans-serif;
      color: var(--text-primary);
      background: rgba(0, 240, 255, 0.05);
      border: 1px solid rgba(0, 240, 255, 0.2);
      border-radius: 8px;
      outline: none;
    }

    .toolbar input:focus,
    .toolbar select:focus {
      border-color: var(--neon-cyan);
      box-shadow: var(--glow-cyan);
    }

    .btn-search {
      height: 42px;
      padding: 0 24px;
      font-family: 'Segoe UI', 'Microsoft YaHei', sans-serif;
      font-size: 14px;
      font-weight: 700;
      color: #000;
      background: linear-gradient(135deg, var(--neon-pink), var(--neon-purple));
      border: none;
      border-radius: 8px;
      cursor: pointer;
      letter-spacing: 2px;
    }

    .empty-state {
      text-align: center;
      padding: 80px 24px;
      background: var(--bg-card);
      backdrop-filter: blur(20px);
      border: 1px solid rgba(0, 240, 255, 0.15);
      border-radius: 16px;
    }

    .empty-state svg {
      width: 64px;
      height: 64px;
      color: var(--text-muted);
      margin-bottom: 20px;
      opacity: 0.5;
    }

    .empty-state p {
      color: var(--text-muted);
      font-size: 16px;
      margin-bottom: 24px;
    }

    .products-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
      gap: 24px;
    }

    .result-summary {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 16px;
      margin-bottom: 24px;
      color: var(--text-muted);
      font-size: 14px;
    }

    .result-summary strong {
      color: var(--neon-cyan);
      font-weight: 600;
    }

    .alert-success {
      padding: 14px 18px;
      margin-bottom: 24px;
      background: rgba(0, 255, 136, 0.1);
      border: 1px solid rgba(0, 255, 136, 0.3);
      border-radius: 8px;
      color: #00ff88;
      font-size: 14px;
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .alert-success svg {
      width: 20px;
      height: 20px;
      flex-shrink: 0;
    }

    .product-card {
      display: block;
      background: var(--bg-card);
      backdrop-filter: blur(20px);
      border: 1px solid rgba(0, 240, 255, 0.1);
      border-radius: 12px;
      overflow: hidden;
      transition: all 0.3s;
      text-decoration: none;
    }

    .product-card:hover {
      border-color: var(--neon-cyan);
      transform: translateY(-4px);
      box-shadow: var(--glow-cyan);
    }

    .product-image {
      width: 100%;
      height: 180px;
      background: linear-gradient(135deg, rgba(0, 240, 255, 0.05), rgba(139, 92, 246, 0.05));
      display: flex;
      align-items: center;
      justify-content: center;
      border-bottom: 1px solid rgba(0, 240, 255, 0.1);
      position: relative;
      overflow: hidden;
    }

    .product-image::before {
      content: '';
      position: absolute;
      top: -50%;
      left: -50%;
      width: 200%;
      height: 200%;
      background: radial-gradient(circle, rgba(0, 240, 255, 0.1) 0%, transparent 60%);
      animation: imageGlow 4s ease-in-out infinite;
    }

    @keyframes imageGlow {
      0%, 100% { transform: scale(1); opacity: 0; }
      50% { transform: scale(1.2); opacity: 1; }
    }

    .product-image img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    .product-image svg {
      width: 48px;
      height: 48px;
      color: var(--text-muted);
      opacity: 0.4;
      position: relative;
      z-index: 1;
    }

    .product-info {
      padding: 20px;
    }

    .product-name {
      font-size: 17px;
      font-weight: 600;
      color: var(--text-primary);
      margin-bottom: 10px;
    }

    .product-price {
      font-family: 'Segoe UI', 'Microsoft YaHei', sans-serif;
      font-size: 22px;
      font-weight: 700;
      color: var(--neon-pink);
    }

    .product-price::before {
      content: '¥ ';
      font-size: 14px;
      opacity: 0.7;
    }

    .product-meta {
      color: var(--text-muted);
      font-size: 13px;
      margin-top: 8px;
    }

    .pagination {
      display: flex;
      justify-content: center;
      align-items: center;
      flex-wrap: wrap;
      gap: 12px;
      margin-top: 36px;
    }

    .pagination-link,
    .pagination-current {
      min-width: 42px;
      height: 42px;
      padding: 0 16px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      border-radius: 8px;
      text-decoration: none;
      font-size: 14px;
      font-weight: 600;
      transition: all 0.3s;
    }

    .pagination-link {
      color: var(--text-primary);
      background: rgba(0, 240, 255, 0.05);
      border: 1px solid rgba(0, 240, 255, 0.18);
    }

    .pagination-link:hover {
      color: var(--neon-cyan);
      border-color: var(--neon-cyan);
      box-shadow: var(--glow-cyan);
    }

    .pagination-current {
      color: #000;
      background: linear-gradient(135deg, var(--neon-cyan), var(--neon-blue));
      border: 1px solid transparent;
    }

    .pagination-info {
      color: var(--text-muted);
      font-size: 14px;
    }

    @media (max-width: 600px) {
      .page-header {
        flex-direction: column;
        gap: 20px;
        align-items: flex-start;
      }
      .toolbar {
        grid-template-columns: 1fr;
      }
      .navbar {
        height: auto;
        padding: 16px;
        gap: 14px;
        flex-direction: column;
        align-items: flex-start;
      }
      .navbar-user {
        flex-wrap: wrap;
      }
      .result-summary {
        flex-direction: column;
        align-items: flex-start;
      }
    }
  </style>
</head>
<body>
  <%
    const currentQuery = query || {};
    const paginationData = pagination || {};
    const buildPageUrl = (pageNumber) => {
      const params = new URLSearchParams();
      if (currentQuery.q) params.set('q', currentQuery.q);
      if (currentQuery.sort && currentQuery.sort !== 'latest') params.set('sort', currentQuery.sort);
      params.set('page', String(pageNumber));
      return '/products?' + params.toString();
    };
  %>
  <nav class="navbar">
    <a class="navbar-brand" href="/">
      <div class="brand-icon">
        <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"></path>
        </svg>
      </div>
      <span class="brand-text">校园二手交易</span>
    </a>
    <div class="navbar-user">
      <span class="user-name">欢迎，<span><%= user.nickname %></span></span>
      <% if (user.role === 'admin') { %>
        <a href="/admin" class="nav-link">管理后台</a>
      <% } else { %>
        <a href="/orders" class="nav-link">我的订单</a>
      <% } %>
      <a href="/logout" class="btn-logout">退出</a>
    </div>
  </nav>

  <div class="container">
    <div class="page-header">
      <h1 class="page-title">商品列表</h1>
      <% if (user.role === 'user') { %>
        <a href="/products/publish" class="btn-publish">+ 发布商品</a>
      <% } %>
    </div>

    <form class="toolbar" method="GET" action="/products">
      <input type="search" name="q" placeholder="搜索商品标题、描述或卖家"
             value="<%= query && query.q ? query.q : '' %>">
      <select name="sort">
        <option value="latest" <%= !query || query.sort === 'latest' ? 'selected' : '' %>>最新发布</option>
        <option value="price_asc" <%= query && query.sort === 'price_asc' ? 'selected' : '' %>>价格升序</option>
        <option value="price_desc" <%= query && query.sort === 'price_desc' ? 'selected' : '' %>>价格降序</option>
      </select>
      <button type="submit" class="btn-search">搜索</button>
    </form>

    <div class="result-summary">
      <span>共找到 <strong><%= paginationData.totalItems || 0 %></strong> 件商品</span>
      <span>第 <strong><%= paginationData.currentPage || 1 %></strong> / <strong><%= paginationData.totalPages || 1 %></strong> 页</span>
    </div>

    <% if (query && query.success) { %>
    <div class="alert-success">
      <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
      </svg>
      <span><%= query.success %></span>
    </div>
    <% } %>

    <% if (products.length === 0) { %>
    <div class="empty-state">
      <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5">
        <path stroke-linecap="round" stroke-linejoin="round" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"></path>
      </svg>
      <p>暂无商品，快来发布第一个商品吧</p>
      <% if (user.role === 'user') { %>
        <a href="/products/publish" class="btn-publish">发布商品</a>
      <% } %>
    </div>
    <% } else { %>
    <div class="products-grid">
      <% products.forEach(function(p) { %>
      <a class="product-card" href="/products/<%= p.id %>">
        <div class="product-image">
          <% if (p.productImages && p.productImages.length > 0) { %>
            <img src="<%= p.productImages[0] %>" alt="<%= p.title %>">
          <% } else { %>
          <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
          </svg>
          <% } %>
        </div>
        <div class="product-info">
          <h3 class="product-name"><%= p.title %></h3>
          <p class="product-price"><%= p.price %></p>
          <p class="product-meta">卖家：<%= p.nickname %></p>
        </div>
      </a>
      <% }); %>
    </div>

    <% if ((paginationData.totalPages || 1) > 1) { %>
    <nav class="pagination" aria-label="商品列表分页">
      <% if (paginationData.hasPrev) { %>
        <a class="pagination-link" href="<%= buildPageUrl(paginationData.currentPage - 1) %>">上一页</a>
      <% } %>

      <% for (let pageNumber = 1; pageNumber <= paginationData.totalPages; pageNumber += 1) { %>
        <% if (pageNumber === paginationData.currentPage) { %>
          <span class="pagination-current"><%= pageNumber %></span>
        <% } else if (
          pageNumber === 1 ||
          pageNumber === paginationData.totalPages ||
          Math.abs(pageNumber - paginationData.currentPage) <= 1
        ) { %>
          <a class="pagination-link" href="<%= buildPageUrl(pageNumber) %>"><%= pageNumber %></a>
        <% } else if (
          pageNumber === paginationData.currentPage - 2 ||
          pageNumber === paginationData.currentPage + 2
        ) { %>
          <span class="pagination-info">...</span>
        <% } %>
      <% } %>

      <% if (paginationData.hasNext) { %>
        <a class="pagination-link" href="<%= buildPageUrl(paginationData.currentPage + 1) %>">下一页</a>
      <% } %>
    </nav>
    <% } %>
    <% } %>
  </div>
</body>
</html>
