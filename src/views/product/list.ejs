<!DOCTYPE html>
<html lang='zh-CN'>
<head>
  <meta charset='UTF-8'>
  <meta name='viewport' content='width=device-width, initial-scale=1.0'>
  <title>商品列表 - 校园二手交易平台</title>
  <style>
    @font-face {
      font-family: 'KaiTi';
      src: local('KaiTi'), local('STKaiti'), local('SimKai'), local('楷体');
    }
    :root {
      --primary: #1B5E20;
      --primary-dark: #144518;
      --secondary: #F5F5DC;
      --accent: #8B4513;
      --text: #3E2723;
      --text-muted: #5D4037;
      --border: #8D6E63;
      --bg: #FFF8E1;
      --bg-paper: #FFFEF5;
    }
    *, *::before, *::after {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }
    body {
      font-family: 'KaiTi', '楷体', STKaiti, SimKai, serif;
      background-color: var(--bg);
      background-image: linear-gradient(90deg, transparent 95%, rgba(139, 69, 19, 0.03) 95%), linear-gradient(transparent 95%, rgba(139, 69, 19, 0.03) 95%);
      background-size: 20px 20px;
      min-height: 100vh;
      color: var(--text);
    }
    .navbar {
      background: var(--primary);
      padding: 0 24px;
      height: 56px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      border-bottom: 3px solid var(--primary-dark);
    }
    .navbar-brand {
      display: flex;
      align-items: center;
      gap: 12px;
      color: var(--secondary) !important;
      text-decoration: none;
    }
    .brand-icon {
      width: 32px;
      height: 32px;
      background: var(--secondary);
      border-radius: 4px;
      display: flex;
      align-items: center;
      justify-content: center;
    }
    .brand-icon svg {
      width: 20px;
      height: 20px;
      color: var(--primary);
    }
    .brand-text {
      font-size: 18px;
      font-weight: bold;
      letter-spacing: 2px;
    }
    .navbar-user {
      display: flex;
      align-items: center;
      gap: 16px;
    }
    .user-name {
      color: var(--secondary);
      font-size: 14px;
    }
    .btn-logout {
      padding: 6px 16px;
      font-family: inherit;
      font-size: 13px;
      color: var(--primary);
      background: var(--secondary);
      border: 2px solid var(--primary-dark);
      border-radius: 4px;
      text-decoration: none;
      transition: all 0.2s;
    }
    .btn-logout:hover {
      background: #EFEBE9;
    }
    .container {
      max-width: 1000px;
      margin: 0 auto;
      padding: 32px 20px;
    }
    .page-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 24px;
      padding-bottom: 16px;
      border-bottom: 2px dashed var(--border);
    }
    .page-title {
      font-size: 26px;
      font-weight: bold;
      color: var(--primary);
      letter-spacing: 2px;
    }
    .btn-publish {
      padding: 10px 20px;
      font-family: inherit;
      font-size: 14px;
      font-weight: bold;
      color: var(--secondary);
      background: linear-gradient(180deg, var(--primary) 0%, var(--primary-dark) 100%);
      border: 2px solid var(--primary-dark);
      border-radius: 4px;
      text-decoration: none;
      transition: all 0.2s;
    }
    .btn-publish:hover {
      transform: translateY(-1px);
      box-shadow: 0 4px 8px rgba(27, 94, 32, 0.3);
    }
    .empty-state {
      text-align: center;
      padding: 60px 20px;
      background: var(--bg-paper);
      border: 2px dashed var(--border);
      border-radius: 8px;
    }
    .empty-state svg {
      width: 56px;
      height: 56px;
      color: var(--border);
      margin-bottom: 16px;
    }
    .empty-state p {
      color: var(--text-muted);
      font-size: 16px;
      margin-bottom: 20px;
    }
    .products-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
      gap: 20px;
    }
    .product-card {
      background: var(--bg-paper);
      border: 2px solid var(--border);
      border-radius: 8px;
      overflow: hidden;
      box-shadow: 3px 3px 0 rgba(62, 39, 35, 0.1);
      transition: all 0.2s;
    }
    .product-card:hover {
      transform: translateY(-2px);
      box-shadow: 4px 4px 0 rgba(62, 39, 35, 0.15);
    }
    .product-image {
      width: 100%;
      height: 160px;
      background: var(--secondary);
      display: flex;
      align-items: center;
      justify-content: center;
      border-bottom: 2px solid var(--border);
    }
    .product-image svg {
      width: 48px;
      height: 48px;
      color: var(--border);
    }
    .product-info {
      padding: 16px;
    }
    .product-name {
      font-size: 16px;
      font-weight: bold;
      color: var(--text);
      margin-bottom: 8px;
    }
    .product-price {
      font-size: 18px;
      font-weight: bold;
      color: var(--accent);
    }
    @media (max-width: 600px) {
      .page-header {
        flex-direction: column;
        gap: 16px;
        align-items: flex-start;
      }
    }
  </style>
</head>
<body>
  <nav class='navbar'>
    <a class='navbar-brand' href='/'>
      <div class='brand-icon'>
        <svg fill='none' stroke='currentColor' viewBox='0 0 24 24' stroke-width='2'>
          <path stroke-linecap='round' stroke-linejoin='round' d='M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z'></path>
        </svg>
      </div>
      <span class='brand-text'>校园二手交易</span>
    </a>
    <div class='navbar-user'>
      <span class='user-name'>欢迎，<%= user.nickname %></span>
      <a href='/logout' class='btn-logout'>退出</a>
    </div>
  </nav>

  <div class='container'>
    <div class='page-header'>
      <h1 class='page-title'>商品列表</h1>
      <a href='/products/publish' class='btn-publish'>发布商品</a>
    </div>

    <% if (products.length === 0) { %>
    <div class='empty-state'>
      <svg fill='none' stroke='currentColor' viewBox='0 0 24 24' stroke-width='2'>
        <path stroke-linecap='round' stroke-linejoin='round' d='M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4'></path>
      </svg>
      <p>暂无商品</p>
      <a href='/products/publish' class='btn-publish'>发布商品</a>
    </div>
    <% } else { %>
    <div class='products-grid'>
      <% products.forEach(function(p) { %>
      <div class='product-card'>
        <div class='product-image'>
          <svg fill='none' stroke='currentColor' viewBox='0 0 24 24' stroke-width='2'>
            <path stroke-linecap='round' stroke-linejoin='round' d='M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z'></path>
          </svg>
        </div>
        <div class='product-info'>
          <h3 class='product-name'><%= p.name %></h3>
          <p class='product-price'>¥<%= p.price %></p>
        </div>
      </div>
      <% }); %>
    </div>
    <% } %>
  </div>
</body>
</html>