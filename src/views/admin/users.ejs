<!DOCTYPE html>
<html lang='zh-CN'>
<head>
  <meta charset='UTF-8'>
  <meta name='viewport' content='width=device-width, initial-scale=1.0'>
  <title>用户管理 - 校园二手交易平台</title>
  <style>
    @font-face {
      font-family: 'KaiTi';
      src: local('KaiTi'), local('STKaiti'), local('SimKai'), local('楷体');
    }
    :root {
      --primary: #1B5E20;
      --primary-dark: #144518;
      --secondary: #F5F5DC;
      --accent: #8B4513;
      --text: #3E2723;
      --text-muted: #5D4037;
      --border: #8D6E63;
      --bg: #FFF8E1;
      --bg-paper: #FFFEF5;
      --sidebar-bg: #1B4D1E;
    }
    *, *::before, *::after {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }
    body {
      font-family: 'KaiTi', '楷体', STKaiti, SimKai, serif;
      background-color: var(--bg);
      background-image: linear-gradient(90deg, transparent 95%, rgba(139, 69, 19, 0.03) 95%), linear-gradient(transparent 95%, rgba(139, 69, 19, 0.03) 95%);
      background-size: 20px 20px;
      min-height: 100vh;
      color: var(--text);
    }
    .navbar {
      background: var(--primary);
      padding: 0 24px;
      height: 56px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      border-bottom: 3px solid var(--primary-dark);
    }
    .navbar-brand {
      display: flex;
      align-items: center;
      gap: 12px;
      color: var(--secondary) !important;
      text-decoration: none;
    }
    .brand-icon {
      width: 32px;
      height: 32px;
      background: var(--secondary);
      border-radius: 4px;
      display: flex;
      align-items: center;
      justify-content: center;
    }
    .brand-icon svg {
      width: 20px;
      height: 20px;
      color: var(--primary);
    }
    .brand-text {
      font-size: 18px;
      font-weight: bold;
      letter-spacing: 2px;
    }
    .navbar-user {
      display: flex;
      align-items: center;
      gap: 16px;
    }
    .user-name {
      color: var(--secondary);
      font-size: 14px;
    }
    .btn-logout {
      padding: 6px 16px;
      font-family: inherit;
      font-size: 13px;
      color: var(--primary);
      background: var(--secondary);
      border: 2px solid var(--primary-dark);
      border-radius: 4px;
      text-decoration: none;
      transition: all 0.2s;
    }
    .btn-logout:hover {
      background: #EFEBE9;
    }
    .layout {
      display: flex;
      min-height: calc(100vh - 56px);
    }
    .sidebar {
      width: 200px;
      background: var(--sidebar-bg);
      border-right: 3px solid var(--primary-dark);
      padding: 16px 0;
      flex-shrink: 0;
    }
    .sidebar-nav {
      list-style: none;
    }
    .sidebar-item {
      margin-bottom: 4px;
    }
    .sidebar-link {
      display: flex;
      align-items: center;
      gap: 10px;
      padding: 12px 20px;
      color: #C8E6C9;
      text-decoration: none;
      font-size: 14px;
      transition: all 0.2s;
      border-left: 4px solid transparent;
    }
    .sidebar-link:hover {
      background: rgba(255, 255, 255, 0.1);
      color: var(--secondary);
    }
    .sidebar-link.active {
      background: rgba(255, 255, 255, 0.15);
      color: var(--secondary);
      border-left-color: #FFEB3B;
    }
    .sidebar-link svg {
      width: 18px;
      height: 18px;
    }
    .main {
      flex: 1;
      padding: 28px;
      overflow-y: auto;
    }
    .page-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 24px;
      padding-bottom: 16px;
      border-bottom: 2px dashed var(--border);
    }
    .page-title {
      font-size: 24px;
      font-weight: bold;
      color: var(--primary);
      letter-spacing: 2px;
    }
    .page-subtitle {
      font-size: 14px;
      color: var(--text-muted);
      margin-top: 4px;
    }
    .btn-back {
      padding: 8px 16px;
      font-family: inherit;
      font-size: 13px;
      color: var(--primary);
      background: var(--bg-paper);
      border: 2px solid var(--border);
      border-radius: 4px;
      text-decoration: none;
      transition: all 0.2s;
    }
    .btn-back:hover {
      background: var(--secondary);
      border-color: var(--primary);
    }
    .table-card {
      background: var(--bg-paper);
      border: 2px solid var(--border);
      border-radius: 8px;
      overflow: hidden;
      box-shadow: 3px 3px 0 rgba(62, 39, 35, 0.1);
    }
    .table {
      width: 100%;
      border-collapse: collapse;
    }
    .table thead {
      background: var(--primary);
    }
    .table thead th {
      padding: 14px 16px;
      text-align: left;
      color: var(--secondary);
      font-size: 14px;
      font-weight: bold;
      letter-spacing: 1px;
      border-bottom: 2px solid var(--primary-dark);
    }
    .table tbody td {
      padding: 14px 16px;
      border-bottom: 1px dashed var(--border);
      font-size: 14px;
    }
    .table tbody tr:hover {
      background: rgba(27, 94, 32, 0.05);
    }
    .table tbody tr:last-child td {
      border-bottom: none;
    }
    .phone-cell {
      font-family: monospace;
    }
    .btn-delete {
      padding: 6px 12px;
      font-family: inherit;
      font-size: 12px;
      color: #FFF;
      background: #C62828;
      border: 2px solid #B71C1C;
      border-radius: 4px;
      cursor: pointer;
      transition: all 0.2s;
    }
    .btn-delete:hover {
      background: #B71C1C;
    }
    .empty-state {
      text-align: center;
      padding: 48px 20px;
      color: var(--text-muted);
    }
    .empty-state svg {
      width: 48px;
      height: 48px;
      margin-bottom: 12px;
      opacity: 0.5;
    }
    @media (max-width: 768px) {
      .sidebar {
        display: none;
      }
      .main {
        padding: 20px 16px;
      }
      .page-header {
        flex-direction: column;
        gap: 12px;
        align-items: flex-start;
      }
    }
  </style>
</head>
<body>
  <nav class='navbar'>
    <a class='navbar-brand' href='/admin'>
      <div class='brand-icon'>
        <svg fill='none' stroke='currentColor' viewBox='0 0 24 24' stroke-width='2'>
          <path stroke-linecap='round' stroke-linejoin='round' d='M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z'></path>
        </svg>
      </div>
      <span class='brand-text'>校园二手交易</span>
    </a>
    <div class='navbar-user'>
      <span class='user-name'><%= user.nickname %></span>
      <a href='/logout' class='btn-logout'>退出</a>
    </div>
  </nav>

  <div class='layout'>
    <aside class='sidebar'>
      <ul class='sidebar-nav'>
        <li class='sidebar-item'>
          <a href='/admin' class='sidebar-link'>
            <svg fill='none' stroke='currentColor' viewBox='0 0 24 24' stroke-width='2'>
              <path stroke-linecap='round' stroke-linejoin='round' d='M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6'></path>
            </svg>
            首页
          </a>
        </li>
        <li class='sidebar-item'>
          <a href='/admin/users' class='sidebar-link active'>
            <svg fill='none' stroke='currentColor' viewBox='0 0 24 24' stroke-width='2'>
              <path stroke-linecap='round' stroke-linejoin='round' d='M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z'></path>
            </svg>
            用户管理
          </a>
        </li>
      </ul>
    </aside>

    <main class='main'>
      <div class='page-header'>
        <div>
          <h1 class='page-title'>用户管理</h1>
          <p class='page-subtitle'>查看和管理普通用户</p>
        </div>
        <a href='/admin' class='btn-back'>返回首页</a>
      </div>

      <% if (users.length === 0) { %>
      <div class='table-card'>
        <div class='empty-state'>
          <svg fill='none' stroke='currentColor' viewBox='0 0 24 24' stroke-width='2'>
            <path stroke-linecap='round' stroke-linejoin='round' d='M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z'></path>
          </svg>
          <p>暂无普通用户</p>
        </div>
      </div>
      <% } else { %>
      <div class='table-card'>
        <table class='table'>
          <thead>
            <tr>
              <th>ID</th>
              <th>手机号</th>
              <th>昵称</th>
              <th>注册时间</th>
              <th>操作</th>
            </tr>
          </thead>
          <tbody>
            <% users.forEach(function(u) { %>
            <tr>
              <td><%= u.id %></td>
              <td class='phone-cell'><%= u.phone %></td>
              <td><%= u.nickname %></td>
              <td><%= new Date(u.created_at).toLocaleString('zh-CN') %></td>
              <td>
                <form action='/admin/users/delete/<%= u.id %>' method='POST' style='display: inline;' onsubmit='return confirm(&quot;确定要删除该用户吗？&quot;);'>
                  <button type='submit' class='btn-delete'>删除</button>
                </form>
              </td>
            </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
      <% } %>
    </main>
  </div>
</body>
</html>