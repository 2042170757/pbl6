<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>订单管理 - 校园二手交易平台</title>
  <link rel="stylesheet" href="/css/common.css">
  <style>
    .main-inner { max-width: 1200px; }
    .stat-value.yellow { color: var(--neon-yellow); }
    .stat-value.pink { color: var(--neon-pink); }

    .status-pending {
      background: rgba(255, 215, 0, 0.15);
      color: var(--neon-yellow);
      border: 1px solid rgba(255, 215, 0, 0.3);
    }

    .status-confirmed {
      background: rgba(0, 255, 136, 0.15);
      color: var(--neon-green);
      border: 1px solid rgba(0, 255, 136, 0.3);
    }

    .status-cancelled, .status-refunded {
      background: rgba(255, 0, 170, 0.15);
      color: var(--neon-pink);
      border: 1px solid rgba(255, 0, 170, 0.3);
    }

    @media (max-width: 768px) {
      .page-title { font-size: 22px; }
    }
  </style>
</head>
<body class="admin-page">
  <%
    const orderList = Array.isArray(orders) ? orders : [];
    const orderStats = stats || { totalOrders: 0, totalAmount: 0, pendingOrders: 0 };
    const dateTimeFormatter = typeof formatDateTime === 'function'
      ? formatDateTime
      : function(value) {
          if (!value) return '-';
          const date = value instanceof Date ? value : new Date(value);
          return Number.isNaN(date.getTime()) ? '-' : date.toLocaleString('zh-CN', { hour12: false });
        };
  %>
  <nav class="navbar">
    <a class="navbar-brand" href="/">
      <div class="brand-icon">
        <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z"></path>
        </svg>
      </div>
      <span class="brand-text">校园二手交易</span>
    </a>
    <div class="navbar-user">
      <span class="user-name">Admin: <span><%= user.nickname %></span></span>
      <a href="/logout" class="btn-logout">退出</a>
    </div>
  </nav>

  <div class="layout">
    <%- include('partials/sidebar', { activePage: 'orders' }) %>

    <main class="main">
      <div class="main-inner">
        <div class="page-header">
          <div class="page-header-left">
            <h1 class="page-title">订单管理</h1>
            <p class="page-subtitle">平台订单数据总览</p>
          </div>
          <a href="/admin" class="btn-back">
            <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
            </svg>
            返回首页
          </a>
        </div>

        <div class="stats-grid">
          <div class="stat-card">
            <div class="stat-value"><%= orderStats.totalOrders %></div>
            <div class="stat-label">总订单数</div>
          </div>
          <div class="stat-card">
            <div class="stat-value yellow">¥<%= parseFloat(orderStats.totalAmount || 0).toFixed(2) %></div>
            <div class="stat-label">成交总额</div>
          </div>
          <div class="stat-card">
            <div class="stat-value pink"><%= orderStats.pendingOrders %></div>
            <div class="stat-label">待处理订单</div>
          </div>
        </div>

        <div class="data-table-wrap">
          <% if (orderList.length === 0) { %>
          <div class="empty-state">
            <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"></path>
            </svg>
            <p>暂无订单记录</p>
          </div>
          <% } else { %>
          <table class="data-table">
            <thead>
              <tr>
                <th>订单号</th>
                <th>商品</th>
                <th>买家</th>
                <th>卖家</th>
                <th>金额</th>
                <th>状态</th>
                <th>下单时间</th>
              </tr>
            </thead>
            <tbody>
              <% orderList.forEach(function(o) { %>
              <tr>
                <td>#<%= String(o.id).padStart(6, '0') %></td>
                <td><%= o.product_title || '商品#' + o.product_id %></td>
                <td><%= o.buyer_nickname || '用户#' + o.buyer_id %></td>
                <td><%= o.seller_nickname || '用户#' + o.seller_id %></td>
                <td><span class="price-tag">¥<%= parseFloat(o.amount).toFixed(2) %></span></td>
                <td>
                  <% if (o.status === 'pending') { %>
                    <span class="status-badge status-pending">待处理</span>
                  <% } else if (o.status === 'confirmed') { %>
                    <span class="status-badge status-confirmed">已完成</span>
                  <% } else if (o.status === 'cancelled') { %>
                    <span class="status-badge status-cancelled">已取消</span>
                  <% } else { %>
                    <span class="status-badge status-refunded">已退款</span>
                  <% } %>
                </td>
                <td><%= dateTimeFormatter(o.created_at) %></td>
              </tr>
              <% }); %>
            </tbody>
          </table>
          <% } %>
        </div>
      </div>
    </main>
  </div>
</body>
</html>
