<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>订单管理 - 校园二手交易平台</title>
  <style>
    /* 本地字体，无外部CDN依赖 */

    :root {
      --bg-deep: #0a0a0f;
      --bg-card: rgba(15, 15, 25, 0.9);
      --bg-sidebar: rgba(8, 8, 15, 0.95);
      --neon-cyan: #00f0ff;
      --neon-pink: #ff00aa;
      --neon-purple: #8b5cf6;
      --neon-blue: #3b82f6;
      --neon-green: #00ff88;
      --neon-yellow: #ffd700;
      --text-primary: #e0e0e0;
      --text-muted: #8892a0;
      --glow-cyan: 0 0 20px rgba(0, 240, 255, 0.4);
      --glow-pink: 0 0 20px rgba(255, 0, 170, 0.4);
    }

    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    body {
      font-family: 'Segoe UI', 'Microsoft YaHei', 'PingFang SC', sans-serif;
      background: var(--bg-deep);
      min-height: 100vh;
      color: var(--text-primary);
      position: relative;
    }

    body::before {
      content: '';
      position: fixed;
      top: 0; left: 0; right: 0; bottom: 0;
      background:
        linear-gradient(90deg, rgba(0, 240, 255, 0.02) 1px, transparent 1px),
        linear-gradient(rgba(0, 240, 255, 0.02) 1px, transparent 1px);
      background-size: 50px 50px;
      pointer-events: none;
      z-index: 0;
    }

    .navbar {
      background: var(--bg-sidebar);
      backdrop-filter: blur(20px);
      padding: 0 24px;
      height: 64px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      border-bottom: 1px solid rgba(0, 240, 255, 0.15);
      position: relative;
      z-index: 10;
    }

    .navbar::after {
      content: '';
      position: absolute;
      bottom: 0; left: 0; right: 0; height: 1px;
      background: linear-gradient(90deg, transparent, var(--neon-cyan), var(--neon-pink), transparent);
    }

    .navbar-brand { display: flex; align-items: center; gap: 14px; color: var(--text-primary); text-decoration: none; }

    .brand-icon {
      width: 38px; height: 38px;
      background: linear-gradient(135deg, var(--neon-cyan), var(--neon-purple));
      border-radius: 8px;
      display: flex;
      align-items: center;
      justify-content: center;
      box-shadow: var(--glow-cyan);
    }

    .brand-icon svg { width: 20px; height: 20px; color: #000; }

    .brand-text {
      font-family: 'Segoe UI', 'Microsoft YaHei', sans-serif;
      font-size: 18px;
      font-weight: 700;
      letter-spacing: 2px;
      background: linear-gradient(90deg, var(--neon-cyan), #fff);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
    }

    .navbar-user { display: flex; align-items: center; gap: 20px; }
    .user-name { color: var(--text-muted); font-size: 15px; font-weight: 500; }
    .user-name span { color: var(--neon-cyan); }

    .btn-logout {
      padding: 8px 20px;
      font-family: 'Segoe UI', 'Microsoft YaHei', sans-serif;
      font-size: 14px;
      font-weight: 600;
      color: var(--neon-pink);
      background: transparent;
      border: 1px solid var(--neon-pink);
      border-radius: 6px;
      text-decoration: none;
      transition: all 0.3s;
      text-transform: uppercase;
      letter-spacing: 1px;
    }

    .btn-logout:hover { background: rgba(255, 0, 170, 0.1); box-shadow: var(--glow-pink); }

    .layout { display: flex; min-height: calc(100vh - 64px); position: relative; z-index: 1; }

    .sidebar {
      width: 240px;
      background: var(--bg-sidebar);
      border-right: 1px solid rgba(0, 240, 255, 0.1);
      padding: 24px 0;
      flex-shrink: 0;
    }

    .sidebar-nav { list-style: none; }

    .sidebar-item { margin-bottom: 4px; }

    .sidebar-link {
      display: flex;
      align-items: center;
      gap: 14px;
      padding: 14px 24px;
      color: var(--text-muted);
      text-decoration: none;
      font-size: 15px;
      font-weight: 500;
      transition: all 0.3s;
      border-left: 3px solid transparent;
      position: relative;
    }

    .sidebar-link:hover { background: rgba(0, 240, 255, 0.05); color: var(--neon-cyan); }

    .sidebar-link.active {
      background: rgba(0, 240, 255, 0.1);
      color: var(--neon-cyan);
      border-left-color: var(--neon-cyan);
    }

    .sidebar-link.active::before {
      content: '';
      position: absolute;
      left: 0; top: 0; bottom: 0; width: 3px;
      background: var(--neon-cyan);
      box-shadow: var(--glow-cyan);
    }

    .sidebar-link svg { width: 20px; height: 20px; }

    .main { flex: 1; padding: 32px; overflow-y: auto; }

    .main-inner { max-width: 1200px; }

    .page-header {
      margin-bottom: 32px;
      padding-bottom: 24px;
      border-bottom: 1px solid rgba(0, 240, 255, 0.1);
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
    }

    .page-header-left { flex: 1; }

    .btn-back {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 10px 18px;
      font-family: 'Segoe UI', 'Microsoft YaHei', sans-serif;
      font-size: 14px;
      font-weight: 500;
      color: var(--text-muted);
      background: transparent;
      border: 1px solid rgba(0, 240, 255, 0.2);
      border-radius: 8px;
      text-decoration: none;
      transition: all 0.3s;
    }

    .btn-back:hover {
      color: var(--neon-cyan);
      border-color: var(--neon-cyan);
      background: rgba(0, 240, 255, 0.05);
    }

    .btn-back svg { width: 16px; height: 16px; }

    .page-title {
      font-family: 'Segoe UI', 'Microsoft YaHei', sans-serif;
      font-size: 28px;
      font-weight: 700;
      background: linear-gradient(90deg, var(--neon-cyan), #fff);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
      letter-spacing: 2px;
      margin-bottom: 8px;
    }

    .page-subtitle { font-size: 15px; color: var(--text-muted); }
    .page-subtitle span { color: var(--neon-pink); }

    .stats-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
      gap: 20px;
      margin-bottom: 32px;
    }

    .stat-card {
      background: var(--bg-card);
      backdrop-filter: blur(20px);
      border: 1px solid rgba(0, 240, 255, 0.15);
      border-radius: 12px;
      padding: 20px;
      position: relative;
      overflow: hidden;
    }

    .stat-card::before {
      content: '';
      position: absolute;
      top: 0; left: 0; right: 0; height: 2px;
      background: linear-gradient(90deg, transparent, var(--neon-cyan), transparent);
    }

    .stat-value {
      font-family: 'Segoe UI', 'Microsoft YaHei', sans-serif;
      font-size: 32px;
      font-weight: 700;
      color: var(--neon-cyan);
      margin-bottom: 4px;
    }

    .stat-value.yellow { color: var(--neon-yellow); }
    .stat-value.pink { color: var(--neon-pink); }

    .stat-label {
      font-size: 13px;
      color: var(--text-muted);
      text-transform: uppercase;
      letter-spacing: 1px;
    }

    .data-table-wrap {
      background: var(--bg-card);
      backdrop-filter: blur(20px);
      border: 1px solid rgba(0, 240, 255, 0.15);
      border-radius: 12px;
      overflow: hidden;
    }

    .data-table { width: 100%; border-collapse: collapse; }

    .data-table th {
      padding: 16px 20px;
      font-family: 'Segoe UI', 'Microsoft YaHei', sans-serif;
      font-size: 12px;
      font-weight: 600;
      color: var(--neon-cyan);
      text-transform: uppercase;
      letter-spacing: 2px;
      text-align: left;
      border-bottom: 1px solid rgba(0, 240, 255, 0.15);
      background: rgba(0, 240, 255, 0.05);
    }

    .data-table td {
      padding: 14px 20px;
      font-size: 14px;
      color: var(--text-primary);
      border-bottom: 1px solid rgba(0, 240, 255, 0.06);
      vertical-align: middle;
    }

    .data-table tr:last-child td { border-bottom: none; }
    .data-table tr:hover td { background: rgba(0, 240, 255, 0.03); }

    .status-badge {
      display: inline-block;
      padding: 4px 12px;
      border-radius: 20px;
      font-size: 12px;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 1px;
    }

    .status-pending {
      background: rgba(255, 215, 0, 0.15);
      color: var(--neon-yellow);
      border: 1px solid rgba(255, 215, 0, 0.3);
    }

    .status-confirmed {
      background: rgba(0, 255, 136, 0.15);
      color: var(--neon-green);
      border: 1px solid rgba(0, 255, 136, 0.3);
    }

    .status-cancelled, .status-refunded {
      background: rgba(255, 0, 170, 0.15);
      color: var(--neon-pink);
      border: 1px solid rgba(255, 0, 170, 0.3);
    }

    .price-tag {
      font-family: 'Segoe UI', 'Microsoft YaHei', sans-serif;
      color: var(--neon-cyan);
      font-weight: 600;
    }

    .empty-state {
      text-align: center;
      padding: 60px 24px;
    }

    .empty-state svg {
      width: 56px; height: 56px;
      color: var(--text-muted);
      margin-bottom: 16px;
      opacity: 0.4;
    }

    .empty-state p { color: var(--text-muted); font-size: 15px; }

    @media (max-width: 768px) {
      .sidebar { display: none; }
      .main { padding: 24px 16px; }
      .page-title { font-size: 22px; }
      .data-table { font-size: 12px; }
      .data-table th, .data-table td { padding: 10px 12px; }
    }
  </style>
</head>
<body>
  <nav class="navbar">
    <a class="navbar-brand" href="/">
      <div class="brand-icon">
        <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z"></path>
        </svg>
      </div>
      <span class="brand-text">校园二手交易</span>
    </a>
    <div class="navbar-user">
      <span class="user-name">Admin: <span><%= user.nickname %></span></span>
      <a href="/logout" class="btn-logout">退出</a>
    </div>
  </nav>

  <div class="layout">
    <%- include('partials/sidebar', { activePage: 'orders' }) %>

    <main class="main">
      <div class="main-inner">
        <div class="page-header">
          <div class="page-header-left">
            <h1 class="page-title">订单管理</h1>
            <p class="page-subtitle">平台订单数据总览</p>
          </div>
          <a href="/admin" class="btn-back">
            <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
            </svg>
            返回首页
          </a>
        </div>

        <div class="stats-grid">
          <div class="stat-card">
            <div class="stat-value"><%= stats.totalOrders %></div>
            <div class="stat-label">总订单数</div>
          </div>
          <div class="stat-card">
            <div class="stat-value yellow">¥<%= parseFloat(stats.totalAmount).toFixed(2) %></div>
            <div class="stat-label">成交总额</div>
          </div>
          <div class="stat-card">
            <div class="stat-value pink"><%= stats.pendingOrders %></div>
            <div class="stat-label">待处理订单</div>
          </div>
        </div>

        <div class="data-table-wrap">
          <% if (orders.length === 0) { %>
          <div class="empty-state">
            <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"></path>
            </svg>
            <p>暂无订单记录</p>
          </div>
          <% } else { %>
          <table class="data-table">
            <thead>
              <tr>
                <th>订单号</th>
                <th>商品</th>
                <th>买家</th>
                <th>卖家</th>
                <th>金额</th>
                <th>状态</th>
                <th>下单时间</th>
              </tr>
            </thead>
            <tbody>
              <% orders.forEach(function(o) { %>
              <tr>
                <td>#<%= String(o.id).padStart(6, '0') %></td>
                <td><%= o.product_title || '商品#' + o.product_id %></td>
                <td><%= o.buyer_nickname || '用户#' + o.buyer_id %></td>
                <td><%= o.seller_nickname || '用户#' + o.seller_id %></td>
                <td><span class="price-tag">¥<%= parseFloat(o.amount).toFixed(2) %></span></td>
                <td>
                  <% if (o.status === 'pending') { %>
                    <span class="status-badge status-pending">待处理</span>
                  <% } else if (o.status === 'confirmed') { %>
                    <span class="status-badge status-confirmed">已完成</span>
                  <% } else if (o.status === 'cancelled') { %>
                    <span class="status-badge status-cancelled">已取消</span>
                  <% } else { %>
                    <span class="status-badge status-refunded">已退款</span>
                  <% } %>
                </td>
                <td><%= o.created_at ? o.created_at.toISOString().slice(0, 19).replace('T', ' ') : '-' %></td>
              </tr>
              <% }); %>
            </tbody>
          </table>
          <% } %>
        </div>
      </div>
    </main>
  </div>
</body>
</html>
