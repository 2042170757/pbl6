<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>商品管理 - 校园二手交易平台</title>
  <link rel="stylesheet" href="/css/common.css">
  <style>
    .main-inner { max-width: 1200px; }

    .status-badge {
      min-width: 60px;
      text-align: center;
    }

    .status-available {
      background: rgba(0, 255, 136, 0.15);
      color: var(--neon-green);
      border: 1px solid rgba(0, 255, 136, 0.3);
    }

    .status-sold {
      background: rgba(139, 92, 246, 0.15);
      color: var(--neon-purple);
      border: 1px solid rgba(139, 92, 246, 0.3);
    }

    .status-deleted {
      background: rgba(255, 0, 170, 0.15);
      color: var(--neon-pink);
      border: 1px solid rgba(255, 0, 170, 0.3);
    }

    .btn-delete {
      padding: 6px 16px;
      font-family: 'Segoe UI', 'Microsoft YaHei', sans-serif;
      font-size: 13px;
      font-weight: 600;
      color: var(--neon-pink);
      background: transparent;
      border: 1px solid var(--neon-pink);
      border-radius: 4px;
      cursor: pointer;
      transition: all 0.3s;
      text-transform: uppercase;
      letter-spacing: 1px;
      text-decoration: none;
      display: inline-block;
    }

    .btn-delete:hover {
      background: rgba(255, 0, 170, 0.15);
      box-shadow: var(--glow-pink);
    }

    @media (max-width: 768px) {
      .page-title { font-size: 22px; }
    }
  </style>
</head>
<body class="admin-page">
  <nav class="navbar">
    <a class="navbar-brand" href="/">
      <div class="brand-icon">
        <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z"></path>
        </svg>
      </div>
      <span class="brand-text">校园二手交易</span>
    </a>
    <div class="navbar-user">
      <span class="user-name">Admin: <span><%= user.nickname %></span></span>
      <a href="/logout" class="btn-logout">退出</a>
    </div>
  </nav>

  <div class="layout">
    <%- include('partials/sidebar', { activePage: 'products' }) %>

    <main class="main">
      <div class="main-inner">
        <div class="page-header">
          <div>
            <h1 class="page-title">商品管理</h1>
            <p class="page-subtitle">共 <span><%= products.length %></span> 件商品</p>
          </div>
          <a href="/admin" class="btn-back">
            <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
            </svg>
            返回首页
          </a>
        </div>

        <div class="data-table-wrap">
          <% if (products.length === 0) { %>
          <div class="empty-state">
            <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"></path>
            </svg>
            <p>暂无商品记录</p>
          </div>
          <% } else { %>
          <table class="data-table">
            <thead>
              <tr>
                <th>ID</th>
                <th>商品标题</th>
                <th>卖家</th>
                <th>价格</th>
                <th>状态</th>
                <th>上架时间</th>
                <th>操作</th>
              </tr>
            </thead>
            <tbody>
              <% products.forEach(function(p) { %>
              <tr>
                <td><%= p.id %></td>
                <td><%= p.title %></td>
                <td><%= p.nickname || '未知' %></td>
                <td><span class="price-tag">¥<%= parseFloat(p.price).toFixed(2) %></span></td>
                <td>
                  <% if (p.status === 'available') { %>
                    <span class="status-badge status-available">在售</span>
                  <% } else if (p.status === 'sold') { %>
                    <span class="status-badge status-sold">已售</span>
                  <% } else { %>
                    <span class="status-badge status-deleted">已删除</span>
                  <% } %>
                </td>
                <td><%= p.created_at ? p.created_at.toISOString().slice(0, 19).replace('T', ' ') : '-' %></td>
                <td>
                  <% if (p.status !== 'deleted') { %>
                  <a href="javascript:void(0)" class="btn-delete"
                     onclick="if(confirm('确定强制下架该商品？')) { fetch('/admin/products/delete/<%= p.id %>', {method:'POST', headers:{'x-csrf-token':'<%= csrfToken %>'}}).then(()=>location.reload()); }">强制下架</a>
                  <% } else { %>
                  <span style="color:var(--text-muted);font-size:12px;">—</span>
                  <% } %>
                </td>
              </tr>
              <% }); %>
            </tbody>
          </table>
          <% } %>
        </div>
      </div>
    </main>
  </div>
</body>
</html>
