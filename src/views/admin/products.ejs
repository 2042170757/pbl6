<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>商品管理 - 校园二手交易平台</title>
  <style>
    /* 本地字体，无外部CDN依赖 */

    :root {
      --bg-deep: #0a0a0f;
      --bg-card: rgba(15, 15, 25, 0.9);
      --bg-sidebar: rgba(8, 8, 15, 0.95);
      --neon-cyan: #00f0ff;
      --neon-pink: #ff00aa;
      --neon-purple: #8b5cf6;
      --neon-blue: #3b82f6;
      --neon-green: #00ff88;
      --text-primary: #e0e0e0;
      --text-muted: #8892a0;
      --glow-cyan: 0 0 20px rgba(0, 240, 255, 0.4);
      --glow-pink: 0 0 20px rgba(255, 0, 170, 0.4);
    }

    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    body {
      font-family: 'Segoe UI', 'Microsoft YaHei', 'PingFang SC', sans-serif;
      background: var(--bg-deep);
      min-height: 100vh;
      color: var(--text-primary);
      position: relative;
    }

    body::before {
      content: '';
      position: fixed;
      top: 0; left: 0; right: 0; bottom: 0;
      background:
        linear-gradient(90deg, rgba(0, 240, 255, 0.02) 1px, transparent 1px),
        linear-gradient(rgba(0, 240, 255, 0.02) 1px, transparent 1px);
      background-size: 50px 50px;
      pointer-events: none;
      z-index: 0;
    }

    .navbar {
      background: var(--bg-sidebar);
      backdrop-filter: blur(20px);
      padding: 0 24px;
      height: 64px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      border-bottom: 1px solid rgba(0, 240, 255, 0.15);
      position: relative;
      z-index: 10;
    }

    .navbar::after {
      content: '';
      position: absolute;
      bottom: 0; left: 0; right: 0; height: 1px;
      background: linear-gradient(90deg, transparent, var(--neon-cyan), var(--neon-pink), transparent);
    }

    .navbar-brand {
      display: flex;
      align-items: center;
      gap: 14px;
      color: var(--text-primary);
      text-decoration: none;
    }

    .brand-icon {
      width: 38px; height: 38px;
      background: linear-gradient(135deg, var(--neon-cyan), var(--neon-purple));
      border-radius: 8px;
      display: flex;
      align-items: center;
      justify-content: center;
      box-shadow: var(--glow-cyan);
    }

    .brand-icon svg { width: 20px; height: 20px; color: #000; }

    .brand-text {
      font-family: 'Segoe UI', 'Microsoft YaHei', sans-serif;
      font-size: 18px;
      font-weight: 700;
      letter-spacing: 2px;
      background: linear-gradient(90deg, var(--neon-cyan), #fff);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
    }

    .navbar-user { display: flex; align-items: center; gap: 20px; }

    .user-name { color: var(--text-muted); font-size: 15px; font-weight: 500; }
    .user-name span { color: var(--neon-cyan); }

    .btn-logout {
      padding: 8px 20px;
      font-family: 'Segoe UI', 'Microsoft YaHei', sans-serif;
      font-size: 14px;
      font-weight: 600;
      color: var(--neon-pink);
      background: transparent;
      border: 1px solid var(--neon-pink);
      border-radius: 6px;
      text-decoration: none;
      transition: all 0.3s;
      text-transform: uppercase;
      letter-spacing: 1px;
    }

    .btn-logout:hover { background: rgba(255, 0, 170, 0.1); box-shadow: var(--glow-pink); }

    .layout { display: flex; min-height: calc(100vh - 64px); position: relative; z-index: 1; }

    .sidebar {
      width: 240px;
      background: var(--bg-sidebar);
      border-right: 1px solid rgba(0, 240, 255, 0.1);
      padding: 24px 0;
      flex-shrink: 0;
    }

    .sidebar-nav { list-style: none; }

    .sidebar-item { margin-bottom: 4px; }

    .sidebar-link {
      display: flex;
      align-items: center;
      gap: 14px;
      padding: 14px 24px;
      color: var(--text-muted);
      text-decoration: none;
      font-size: 15px;
      font-weight: 500;
      transition: all 0.3s;
      border-left: 3px solid transparent;
      position: relative;
    }

    .sidebar-link:hover { background: rgba(0, 240, 255, 0.05); color: var(--neon-cyan); }

    .sidebar-link.active {
      background: rgba(0, 240, 255, 0.1);
      color: var(--neon-cyan);
      border-left-color: var(--neon-cyan);
    }

    .sidebar-link.active::before {
      content: '';
      position: absolute;
      left: 0; top: 0; bottom: 0; width: 3px;
      background: var(--neon-cyan);
      box-shadow: var(--glow-cyan);
    }

    .sidebar-link svg { width: 20px; height: 20px; }

    .main { flex: 1; padding: 32px; overflow-y: auto; }

    .main-inner { max-width: 1200px; }

    .page-header {
      margin-bottom: 32px;
      padding-bottom: 24px;
      border-bottom: 1px solid rgba(0, 240, 255, 0.1);
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    .btn-back {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 10px 18px;
      font-family: 'Segoe UI', 'Microsoft YaHei', sans-serif;
      font-size: 14px;
      font-weight: 500;
      color: var(--text-muted);
      background: transparent;
      border: 1px solid rgba(0, 240, 255, 0.2);
      border-radius: 8px;
      text-decoration: none;
      transition: all 0.3s;
    }

    .btn-back:hover {
      color: var(--neon-cyan);
      border-color: var(--neon-cyan);
      background: rgba(0, 240, 255, 0.05);
    }

    .btn-back svg { width: 16px; height: 16px; }

    .page-title {
      font-family: 'Segoe UI', 'Microsoft YaHei', sans-serif;
      font-size: 28px;
      font-weight: 700;
      background: linear-gradient(90deg, var(--neon-cyan), #fff);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
      letter-spacing: 2px;
    }

    .page-subtitle { font-size: 15px; color: var(--text-muted); }
    .page-subtitle span { color: var(--neon-pink); }

    .filter-tabs {
      display: flex;
      gap: 12px;
      margin-bottom: 24px;
    }

    .filter-tab {
      padding: 8px 20px;
      font-family: 'Segoe UI', 'Microsoft YaHei', sans-serif;
      font-size: 14px;
      font-weight: 600;
      color: var(--text-muted);
      background: var(--bg-card);
      border: 1px solid rgba(0, 240, 255, 0.1);
      border-radius: 6px;
      text-decoration: none;
      transition: all 0.3s;
      text-transform: uppercase;
      letter-spacing: 1px;
    }

    .filter-tab:hover { color: var(--neon-cyan); border-color: rgba(0, 240, 255, 0.3); }

    .filter-tab.active {
      color: var(--neon-cyan);
      border-color: var(--neon-cyan);
      background: rgba(0, 240, 255, 0.08);
    }

    .data-table-wrap {
      background: var(--bg-card);
      backdrop-filter: blur(20px);
      border: 1px solid rgba(0, 240, 255, 0.15);
      border-radius: 12px;
      overflow: hidden;
    }

    .data-table {
      width: 100%;
      border-collapse: collapse;
    }

    .data-table th {
      padding: 16px 20px;
      font-family: 'Segoe UI', 'Microsoft YaHei', sans-serif;
      font-size: 12px;
      font-weight: 600;
      color: var(--neon-cyan);
      text-transform: uppercase;
      letter-spacing: 2px;
      text-align: left;
      border-bottom: 1px solid rgba(0, 240, 255, 0.15);
      background: rgba(0, 240, 255, 0.05);
    }

    .data-table td {
      padding: 14px 20px;
      font-size: 14px;
      color: var(--text-primary);
      border-bottom: 1px solid rgba(0, 240, 255, 0.06);
      vertical-align: middle;
    }

    .data-table tr:last-child td { border-bottom: none; }

    .data-table tr:hover td { background: rgba(0, 240, 255, 0.03); }

    .status-badge {
      display: inline-block;
      padding: 4px 12px;
      border-radius: 20px;
      font-size: 12px;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 1px;
    }

    .status-available {
      background: rgba(0, 255, 136, 0.15);
      color: var(--neon-green);
      border: 1px solid rgba(0, 255, 136, 0.3);
    }

    .status-sold {
      background: rgba(139, 92, 246, 0.15);
      color: var(--neon-purple);
      border: 1px solid rgba(139, 92, 246, 0.3);
    }

    .status-deleted {
      background: rgba(255, 0, 170, 0.15);
      color: var(--neon-pink);
      border: 1px solid rgba(255, 0, 170, 0.3);
    }

    .btn-delete {
      padding: 6px 16px;
      font-family: 'Segoe UI', 'Microsoft YaHei', sans-serif;
      font-size: 13px;
      font-weight: 600;
      color: var(--neon-pink);
      background: transparent;
      border: 1px solid var(--neon-pink);
      border-radius: 4px;
      cursor: pointer;
      transition: all 0.3s;
      text-transform: uppercase;
      letter-spacing: 1px;
      text-decoration: none;
      display: inline-block;
    }

    .btn-delete:hover {
      background: rgba(255, 0, 170, 0.15);
      box-shadow: var(--glow-pink);
    }

    .price-tag {
      font-family: 'Segoe UI', 'Microsoft YaHei', sans-serif;
      color: var(--neon-cyan);
      font-weight: 600;
    }

    .empty-state {
      text-align: center;
      padding: 60px 24px;
    }

    .empty-state svg {
      width: 56px; height: 56px;
      color: var(--text-muted);
      margin-bottom: 16px;
      opacity: 0.4;
    }

    .empty-state p { color: var(--text-muted); font-size: 15px; }

    @media (max-width: 768px) {
      .sidebar { display: none; }
      .main { padding: 24px 16px; }
      .page-title { font-size: 22px; }
      .data-table { font-size: 12px; }
      .data-table th, .data-table td { padding: 10px 12px; }
    }
  </style>
</head>
<body>
  <nav class="navbar">
    <a class="navbar-brand" href="/">
      <div class="brand-icon">
        <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z"></path>
        </svg>
      </div>
      <span class="brand-text">校园二手交易</span>
    </a>
    <div class="navbar-user">
      <span class="user-name">Admin: <span><%= user.nickname %></span></span>
      <a href="/logout" class="btn-logout">退出</a>
    </div>
  </nav>

  <div class="layout">
    <aside class="sidebar">
      <ul class="sidebar-nav">
        <li class="sidebar-item">
          <a href="/admin" class="sidebar-link">
            <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"></path>
            </svg>
            首页
          </a>
        </li>
        <li class="sidebar-item">
          <a href="/admin/users" class="sidebar-link">
            <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"></path>
            </svg>
            用户管理
          </a>
        </li>
        <li class="sidebar-item">
          <a href="/admin/products" class="sidebar-link active">
            <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"></path>
            </svg>
            商品管理
          </a>
        </li>
        <li class="sidebar-item">
          <a href="/admin/orders" class="sidebar-link">
            <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-3 7h3m-3 4h3m-6-4h.01M9 16h.01"></path>
            </svg>
            订单管理
          </a>
        </li>
      </ul>
    </aside>

    <main class="main">
      <div class="main-inner">
        <div class="page-header">
          <div>
            <h1 class="page-title">商品管理</h1>
            <p class="page-subtitle">共 <span><%= products.length %></span> 件商品</p>
          </div>
          <a href="/admin" class="btn-back">
            <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
            </svg>
            返回首页
          </a>
        </div>

        <div class="data-table-wrap">
          <% if (products.length === 0) { %>
          <div class="empty-state">
            <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"></path>
            </svg>
            <p>暂无商品记录</p>
          </div>
          <% } else { %>
          <table class="data-table">
            <thead>
              <tr>
                <th>ID</th>
                <th>商品标题</th>
                <th>卖家</th>
                <th>价格</th>
                <th>状态</th>
                <th>上架时间</th>
                <th>操作</th>
              </tr>
            </thead>
            <tbody>
              <% products.forEach(function(p) { %>
              <tr>
                <td><%= p.id %></td>
                <td><%= p.title %></td>
                <td><%= p.nickname || '未知' %></td>
                <td><span class="price-tag">¥<%= parseFloat(p.price).toFixed(2) %></span></td>
                <td>
                  <% if (p.status === 'available') { %>
                    <span class="status-badge status-available">在售</span>
                  <% } else if (p.status === 'sold') { %>
                    <span class="status-badge status-sold">已售</span>
                  <% } else { %>
                    <span class="status-badge status-deleted">已删除</span>
                  <% } %>
                </td>
                <td><%= p.created_at ? p.created_at.toISOString().slice(0, 19).replace('T', ' ') : '-' %></td>
                <td>
                  <% if (p.status !== 'deleted') { %>
                  <a href="javascript:void(0)" class="btn-delete"
                     onclick="if(confirm('确定强制下架该商品？')) { fetch('/admin/products/delete/<%= p.id %>', {method:'POST'}).then(()=>location.reload()); }">强制下架</a>
                  <% } else { %>
                  <span style="color:var(--text-muted);font-size:12px;">—</span>
                  <% } %>
                </td>
              </tr>
              <% }); %>
            </tbody>
          </table>
          <% } %>
        </div>
      </div>
    </main>
  </div>
</body>
</html>