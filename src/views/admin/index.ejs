<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>管理后台 - 校园二手交易平台</title>
  <style>
    @font-face {
      font-family: 'KaiTi';
      src: local('KaiTi'), local('STKaiti'), local('SimKai'), local('楷体');
    }
    :root {
      --primary: #1B5E20;
      --primary-dark: #144518;
      --primary-light: #2E7D32;
      --secondary: #F5F5DC;
      --accent: #8B4513;
      --text: #3E2723;
      --text-muted: #5D4037;
      --border: #8D6E63;
      --bg: #FFF8E1;
      --bg-paper: #FFFEF5;
      --sidebar-bg: #1B4D1E;
    }
    *, *::before, *::after {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }
    body {
      font-family: "KaiTi", "楷体", STKaiti, SimKai, serif;
      background-color: var(--bg);
      background-image:
        linear-gradient(90deg, transparent 95%, rgba(139, 69, 19, 0.03) 95%),
        linear-gradient(transparent 95%, rgba(139, 69, 19, 0.03) 95%);
      background-size: 20px 20px;
      min-height: 100vh;
      color: var(--text);
    }
    .navbar {
      background: var(--primary);
      padding: 0 24px;
      height: 56px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      border-bottom: 3px solid var(--primary-dark);
    }
    .navbar-brand {
      display: flex;
      align-items: center;
      gap: 12px;
      color: var(--secondary);
      text-decoration: none;
    }
    .brand-icon {
      width: 32px;
      height: 32px;
      background: var(--secondary);
      border-radius: 4px;
      display: flex;
      align-items: center;
      justify-content: center;
    }
    .brand-icon svg {
      width: 20px;
      height: 20px;
      color: var(--primary);
    }
    .brand-text {
      font-size: 18px;
      font-weight: bold;
      letter-spacing: 2px;
    }
    .navbar-user {
      display: flex;
      align-items: center;
      gap: 16px;
    }
    .user-name {
      color: var(--secondary);
      font-size: 14px;
    }
    .btn-logout {
      padding: 6px 16px;
      font-family: inherit;
      font-size: 13px;
      color: var(--primary);
      background: var(--secondary);
      border: 2px solid var(--primary-dark);
      border-radius: 4px;
      text-decoration: none;
      transition: all 0.2s;
    }
    .btn-logout:hover {
      background: #EFEBE9;
    }
    .layout {
      display: flex;
      min-height: calc(100vh - 56px);
    }
    .sidebar {
      width: 200px;
      background: var(--sidebar-bg);
      border-right: 3px solid var(--primary-dark);
      padding: 16px 0;
      flex-shrink: 0;
    }
    .sidebar-nav {
      list-style: none;
    }
    .sidebar-item {
      margin-bottom: 4px;
    }
    .sidebar-link {
      display: flex;
      align-items: center;
      gap: 10px;
      padding: 12px 20px;
      color: #C8E6C9;
      text-decoration: none;
      font-size: 14px;
      transition: all 0.2s;
      border-left: 4px solid transparent;
    }
    .sidebar-link:hover {
      background: rgba(255, 255, 255, 0.1);
      color: var(--secondary);
    }
    .sidebar-link.active {
      background: rgba(255, 255, 255, 0.15);
      color: var(--secondary);
      border-left-color: #FFEB3B;
    }
    .sidebar-link svg {
      width: 18px;
      height: 18px;
    }
    .main {
      flex: 1;
      padding: 28px;
      overflow-y: auto;
    }
    .main-inner {
      max-width: 1000px;
    }
    .page-header {
      margin-bottom: 28px;
      padding-bottom: 20px;
      border-bottom: 2px dashed var(--border);
    }
    .page-title {
      font-size: 26px;
      font-weight: bold;
      color: var(--primary);
      letter-spacing: 2px;
      margin-bottom: 6px;
    }
    .page-subtitle {
      font-size: 14px;
      color: var(--text-muted);
    }
    .stats-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
      gap: 20px;
      margin-bottom: 32px;
    }
    .stat-card {
      background: var(--bg-paper);
      border: 2px solid var(--border);
      border-radius: 8px;
      padding: 20px;
      box-shadow: 3px 3px 0 rgba(62, 39, 35, 0.1);
      transition: all 0.2s;
    }
    .stat-card:hover {
      transform: translateY(-2px);
      box-shadow: 4px 4px 0 rgba(62, 39, 35, 0.15);
    }
    .stat-icon {
      width: 44px;
      height: 44px;
      background: var(--primary);
      border-radius: 4px;
      display: flex;
      align-items: center;
      justify-content: center;
      margin-bottom: 12px;
      border: 2px solid var(--primary-dark);
    }
    .stat-icon svg {
      width: 22px;
      height: 22px;
      color: var(--secondary);
    }
    .stat-value {
      font-size: 28px;
      font-weight: bold;
      color: var(--primary);
      margin-bottom: 4px;
    }
    .stat-label {
      font-size: 13px;
      color: var(--text-muted);
    }
    .section-title {
      font-size: 16px;
      font-weight: bold;
      color: var(--text);
      margin-bottom: 16px;
      letter-spacing: 1px;
    }
    .actions-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
      gap: 16px;
    }
    .action-card {
      display: flex;
      align-items: center;
      gap: 16px;
      padding: 18px;
      background: var(--bg-paper);
      border: 2px solid var(--border);
      border-radius: 8px;
      text-decoration: none;
      box-shadow: 3px 3px 0 rgba(62, 39, 35, 0.1);
      transition: all 0.2s;
    }
    .action-card:hover {
      transform: translateY(-2px);
      box-shadow: 4px 4px 0 rgba(62, 39, 35, 0.15);
      border-color: var(--primary);
    }
    .action-icon {
      width: 44px;
      height: 44px;
      background: var(--primary);
      border-radius: 4px;
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
      border: 2px solid var(--primary-dark);
    }
    .action-icon svg {
      width: 22px;
      height: 22px;
      color: var(--secondary);
    }
    .action-content {
      flex: 1;
    }
    .action-title {
      font-size: 15px;
      font-weight: bold;
      color: var(--text);
      margin-bottom: 4px;
    }
    .action-desc {
      font-size: 13px;
      color: var(--text-muted);
    }
    @media (max-width: 768px) {
      .sidebar {
        display: none;
      }
      .main {
        padding: 20px 16px;
      }
      .page-title {
        font-size: 22px;
      }
    }
  </style>
</head>
<body>
  <nav class="navbar">
    <a class="navbar-brand" href="/">
      <div class="brand-icon">
        <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z"></path>
        </svg>
      </div>
      <span class="brand-text">校园二手交易</span>
    </a>
    <div class="navbar-user">
      <span class="user-name"><%= user.nickname %></span>
      <a href="/logout" class="btn-logout">退出</a>
    </div>
  </nav>

  <div class="layout">
    <aside class="sidebar">
      <ul class="sidebar-nav">
        <li class="sidebar-item">
          <a href="/admin" class="sidebar-link active">
            <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"></path>
            </svg>
            首页
          </a>
        </li>
        <li class="sidebar-item">
          <a href="/admin/users" class="sidebar-link">
            <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"></path>
            </svg>
            用户管理
          </a>
        </li>
        <li class="sidebar-item">
          <a href="/admin/products" class="sidebar-link">
            <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"></path>
            </svg>
            商品管理
          </a>
        </li>
        <li class="sidebar-item">
          <a href="/admin/orders" class="sidebar-link">
            <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-3 7h3m-3 4h3m-6-4h.01M9 16h.01"></path>
            </svg>
            订单管理
          </a>
        </li>
      </ul>
    </aside>

    <main class="main">
      <div class="main-inner">
        <div class="page-header">
          <h1 class="page-title">管理后台</h1>
          <p class="page-subtitle">欢迎回来，<%= user.nickname %></p>
        </div>

        <div class="stats-grid">
          <div class="stat-card">
            <div class="stat-icon">
              <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"></path>
              </svg>
            </div>
            <div class="stat-value"><%= stats.userCount %></div>
            <div class="stat-label">注册用户</div>
          </div>
          <div class="stat-card">
            <div class="stat-icon">
              <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"></path>
              </svg>
            </div>
            <div class="stat-value"><%= stats.productCount %></div>
            <div class="stat-label">在售商品</div>
          </div>
        </div>

        <h2 class="section-title">快捷操作</h2>
        <div class="actions-grid">
          <a href="/admin/users" class="action-card">
            <div class="action-icon">
              <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z"></path>
              </svg>
            </div>
            <div class="action-content">
              <h3 class="action-title">用户管理</h3>
              <p class="action-desc">查看和管理注册用户</p>
            </div>
          </a>
          <a href="/admin/products" class="action-card">
            <div class="action-icon">
              <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path>
              </svg>
            </div>
            <div class="action-content">
              <h3 class="action-title">商品管理</h3>
              <p class="action-desc">管理所有商品</p>
            </div>
          </a>
          <a href="/admin/orders" class="action-card">
            <div class="action-icon">
              <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"></path>
              </svg>
            </div>
            <div class="action-content">
              <h3 class="action-title">订单管理</h3>
              <p class="action-desc">查看和处理订单</p>
            </div>
          </a>
        </div>
      </div>
    </main>
  </div>
</body>
</html>