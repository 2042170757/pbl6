<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>管理后台 - 校园二手交易平台</title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  <link rel="stylesheet" href="/css/common.css">
  <style>
    .stat-icon {
      width: 48px;
      height: 48px;
      background: linear-gradient(135deg, rgba(0, 240, 255, 0.2), rgba(139, 92, 246, 0.2));
      border-radius: 10px;
      display: flex;
      align-items: center;
      justify-content: center;
      margin-bottom: 16px;
      border: 1px solid rgba(0, 240, 255, 0.2);
    }

    .stat-icon svg {
      width: 24px;
      height: 24px;
      color: var(--neon-cyan);
    }

    .stat-value {
      font-family: 'Segoe UI', 'Microsoft YaHei', sans-serif;
      font-size: 36px;
      font-weight: 700;
      color: var(--neon-cyan);
      margin-bottom: 6px;
      text-shadow: var(--glow-cyan);
    }

    .stat-label {
      font-size: 14px;
      color: var(--text-muted);
      text-transform: uppercase;
      letter-spacing: 1px;
    }

    .section-title {
      font-family: 'Segoe UI', 'Microsoft YaHei', sans-serif;
      font-size: 16px;
      font-weight: 600;
      color: var(--text-primary);
      margin-bottom: 20px;
      letter-spacing: 2px;
      text-transform: uppercase;
    }

    .actions-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
      gap: 20px;
    }

    .action-card {
      display: flex;
      align-items: center;
      gap: 18px;
      padding: 20px;
      background: var(--bg-card);
      backdrop-filter: blur(20px);
      border: 1px solid rgba(0, 240, 255, 0.1);
      border-radius: 12px;
      text-decoration: none;
      transition: all 0.3s;
    }

    .action-card:hover {
      border-color: var(--neon-purple);
      transform: translateY(-2px);
      box-shadow: 0 0 30px rgba(139, 92, 246, 0.2);
    }

    .action-icon {
      width: 48px;
      height: 48px;
      background: linear-gradient(135deg, rgba(139, 92, 246, 0.2), rgba(255, 0, 170, 0.2));
      border-radius: 10px;
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
      border: 1px solid rgba(139, 92, 246, 0.2);
    }

    .action-icon svg {
      width: 22px;
      height: 22px;
      color: var(--neon-purple);
    }

    .action-content {
      flex: 1;
    }

    .action-title {
      font-size: 16px;
      font-weight: 600;
      color: var(--text-primary);
      margin-bottom: 4px;
    }

    .action-desc {
      font-size: 13px;
      color: var(--text-muted);
    }

    .stats-grid {
      grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
      gap: 24px;
      margin-bottom: 40px;
    }

    .stat-card {
      padding: 24px;
    }

    .stat-card:hover {
      border-color: rgba(0, 240, 255, 0.3);
      transform: translateY(-4px);
      box-shadow: var(--glow-cyan);
    }

    .stat-value {
      font-size: 36px;
      margin-bottom: 6px;
      text-shadow: var(--glow-cyan);
    }

    .stat-label {
      font-size: 14px;
    }

    @media (max-width: 768px) {
      .page-title {
        font-size: 24px;
      }
    }
  </style>
  <link rel="stylesheet" href="/css/campus-glass.css">
</head>
<body class="admin-page">
  <nav class="navbar">
    <a class="navbar-brand" href="/">
      <div class="brand-icon">
        <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z"></path>
        </svg>
      </div>
      <span class="brand-text">校园二手交易</span>
    </a>
    <div class="navbar-user">
      <span class="user-name">Admin: <span><%= user.nickname %></span></span>
      <a href="/logout" class="btn-logout">退出</a>
    </div>
  </nav>

  <div class="layout">
    <%- include('partials/sidebar', { activePage: 'index' }) %>

    <main class="main">
      <div class="main-inner">
        <div class="page-header">
          <div class="page-header-left">
            <h1 class="page-title">管理后台</h1>
            <p class="page-subtitle">欢迎回来，<span><%= user.nickname %></span></p>
          </div>
          <a href="/products" class="btn-back">
            <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
            </svg>
            返回前台
          </a>
        </div>

        <div class="stats-grid">
          <div class="stat-card">
            <div class="stat-icon">
              <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"></path>
              </svg>
            </div>
            <div class="stat-value"><%= stats.userCount %></div>
            <div class="stat-label">注册用户</div>
          </div>
          <div class="stat-card">
            <div class="stat-icon">
              <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"></path>
              </svg>
            </div>
            <div class="stat-value"><%= stats.productCount %></div>
            <div class="stat-label">在售商品</div>
          </div>
          <div class="stat-card">
            <div class="stat-icon">
              <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6M9 7h6m2 0H7m3-3h4a1 1 0 011 1v2H8V5a1 1 0 011-1z"></path>
              </svg>
            </div>
            <div class="stat-value"><%= (stats.recycleUserCount || 0) + (stats.recycleProductCount || 0) %></div>
            <div class="stat-label">回收站条目</div>
          </div>
        </div>

        <h2 class="section-title">快捷操作</h2>
        <div class="actions-grid">
          <a href="/admin/users" class="action-card">
            <div class="action-icon">
              <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z"></path>
              </svg>
            </div>
            <div class="action-content">
              <h3 class="action-title">用户管理</h3>
              <p class="action-desc">查看和管理注册用户</p>
            </div>
          </a>
          <a href="/admin/products" class="action-card">
            <div class="action-icon">
              <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path>
              </svg>
            </div>
            <div class="action-content">
              <h3 class="action-title">商品管理</h3>
              <p class="action-desc">管理所有商品</p>
            </div>
          </a>
          <a href="/admin/orders" class="action-card">
            <div class="action-icon">
              <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"></path>
              </svg>
            </div>
            <div class="action-content">
              <h3 class="action-title">订单管理</h3>
              <p class="action-desc">查看和处理订单</p>
            </div>
          </a>
          <a href="/admin/recycle-bin" class="action-card">
            <div class="action-icon">
              <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6M9 7h6m2 0H7m3-3h4a1 1 0 011 1v2H8V5a1 1 0 011-1z"></path>
              </svg>
            </div>
            <div class="action-content">
              <h3 class="action-title">回收站</h3>
              <p class="action-desc">恢复或彻底删除用户与商品</p>
            </div>
          </a>
        </div>
      </div>
    </main>
  </div>
</body>
</html>
